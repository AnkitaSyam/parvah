{
  "name": "parvah-backend",
  "version": "1.0.0",
  "description": "Parvah Maternal Health Express Backend",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "start": "node index.js",
    "dev": "node --watch --watch-path=routes --watch-path=services --watch-path=config --watch-path=middleware --watch-path=index.js index.js",
    "db:seed": "node scripts/seed.js",
    "seed:myths": "node scripts/seedMythDatabase.js",
    "embed:myths": "node scripts/embedMyths.js",
    "setup": "npm run seed:myths && npm run embed:myths",
    "test": "npm run test:redflags && npm run test:schedule && npm run test:vitals",
    "test:redflags": "node tests/testRedFlagClassification.js",
    "test:schedule": "node tests/testCareSchedule.js",
    "test:rls": "node scripts/testRls.js",
    "test:vitals": "node tests/testVitalsAndGrowth.js",
    "test:inbound-sms": "node scripts/testInboundSms.js"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.0",
    "@xenova/transformers": "^2.17.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "groq-sdk": "^0.7.0",
    "multer": "^2.3.0",
    "pg": "^8.23.0",
    "twilio": "^5.2.0"
  }
}
